<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт личных расходов" Height="600" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учёт личных расходов"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <GroupBox Grid.Row="1" Header="Добавить расход" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сумма"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Категория"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Дата"/>

                <TextBox x:Name="AmountTextBox" Grid.Row="1" Grid.Column="0"
                         Height="28" Margin="0,5,10,10"/>
                <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Grid.Column="1"
                          Height="28" Margin="0,5,10,10" SelectedIndex="0">
                    <ComboBoxItem Content="Продукты"/>
                    <ComboBoxItem Content="Транспорт"/>
                    <ComboBoxItem Content="Развлечения"/>
                    <ComboBoxItem Content="Другое"/>
                </ComboBox>
                <DatePicker x:Name="ExpenseDatePicker" Grid.Row="1" Grid.Column="2"
                            Height="28" Margin="0,5,0,10"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Описание"/>
                <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.ColumnSpan="3"
                         Height="28" Margin="0,5,0,10"/>

                <Button x:Name="AddExpenseButton" Grid.Row="4" Grid.ColumnSpan="3"
                        Content="Добавить расход" Width="150" Height="30"
                        HorizontalAlignment="Left"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Показать категорию:" VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="FilterCategoryComboBox" Width="170" SelectedIndex="0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Продукты"/>
                <ComboBoxItem Content="Транспорт"/>
                <ComboBoxItem Content="Развлечения"/>
                <ComboBoxItem Content="Другое"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="ExpensesDataGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding ExpenseDate, StringFormat=dd.MM.yyyy}"
                                    Width="120"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="DeleteExpenseButton" Content="Удалить выбранный"
                    Width="150" Height="30"/>
            <TextBlock x:Name="TotalTextBlock" Text="Общая сумма: 0 ₽"
                       FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
